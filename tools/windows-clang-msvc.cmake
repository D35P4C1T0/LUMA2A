set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(OPTO_WINSDK_ROOT "" CACHE PATH "Microsoft CRT and Windows SDK root")
get_filename_component(OPTO_WINSDK_ROOT "${OPTO_WINSDK_ROOT}" ABSOLUTE)
set(OPTO_LLVM_ROOT "/opt/homebrew/opt/llvm" CACHE PATH "Native LLVM tools root")
set(CMAKE_C_COMPILER "${OPTO_LLVM_ROOT}/bin/clang-cl")
set(CMAKE_CXX_COMPILER "${OPTO_LLVM_ROOT}/bin/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
find_program(OPTO_LLD_LINK lld-link REQUIRED)
set(CMAKE_LINKER "${OPTO_LLD_LINK}")
set(CMAKE_AR "${OPTO_LLVM_ROOT}/bin/llvm-lib")
set(CMAKE_RC_COMPILER "${OPTO_LLVM_ROOT}/bin/llvm-rc")
set(CMAKE_MT "${OPTO_LLVM_ROOT}/bin/llvm-mt")
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded")
set(OPTO_SDK_INCLUDES "/imsvc\"${OPTO_WINSDK_ROOT}/crt/include\" /imsvc\"${OPTO_WINSDK_ROOT}/sdk/include/ucrt\" /imsvc\"${OPTO_WINSDK_ROOT}/sdk/include/shared\" /imsvc\"${OPTO_WINSDK_ROOT}/sdk/include/um\" /imsvc\"${OPTO_WINSDK_ROOT}/sdk/include/winrt\"")
set(CMAKE_C_FLAGS_INIT "${OPTO_SDK_INCLUDES}")
set(CMAKE_CXX_FLAGS_INIT "${OPTO_SDK_INCLUDES} /clang:-fdelayed-template-parsing /fp:strict")
set(CMAKE_RC_FLAGS_INIT "/I\"${OPTO_WINSDK_ROOT}/sdk/include/um\" /I\"${OPTO_WINSDK_ROOT}/sdk/include/shared\"")
set(OPTO_SDK_LIBS "/libpath:\"${OPTO_WINSDK_ROOT}/crt/lib/x86_64\" /libpath:\"${OPTO_WINSDK_ROOT}/sdk/lib/ucrt/x86_64\" /libpath:\"${OPTO_WINSDK_ROOT}/sdk/lib/um/x86_64\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${OPTO_SDK_LIBS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${OPTO_SDK_LIBS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${OPTO_SDK_LIBS}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
